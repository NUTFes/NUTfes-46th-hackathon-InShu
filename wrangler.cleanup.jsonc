{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inshu-cleanup",
  "main": "src/cleanup-worker.ts",
  "compatibility_date": "2026-11-01",
  "triggers": {"crons": ["0 19 * * *"]},
  "d1_databases": [{"binding":"DB","database_name":"inshu-local","database_id":"00000000-0000-0000-0000-000000000000"}],
  "r2_buckets": [{"binding":"PHOTOS","bucket_name":"inshu-photos-local"}]
}
